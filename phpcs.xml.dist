<?xml version="1.0"?>
<ruleset name="STM-NonceVerification">
    <description>CSRF/nonce verification checks for admin form and AJAX handlers.</description>

    <config name="minimum_supported_wp_version" value="6.0"/>

    <rule ref="WordPress.Security.NonceVerification"/>

    <file>includes/class-admin.php</file>
    <file>includes/class-import-export.php</file>
    <file>includes/class-dashboard.php</file>
    <file>templates/admin-translations.php</file>
    <file>templates/admin-import-export.php</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
</ruleset>
