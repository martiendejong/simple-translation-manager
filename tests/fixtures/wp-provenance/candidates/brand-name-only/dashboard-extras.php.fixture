if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * Optional integration with Fixture Lantern Sync: when that plugin keeps its records in the option
 * we know about, show how many lanterns there are on the dashboard. We only read; we never write.
 */
function dex_lantern_count() {
	$records = get_option( 'fls_lanterns', array() );
	return is_array( $records ) ? count( $records ) : 0;
}

function dex_dashboard_widget() {
	$count = dex_lantern_count();
	echo '<p>' . esc_html( sprintf( _n( '%d lantern is registered.', '%d lanterns are registered.', $count, 'dashboard-extras' ), $count ) ) . '</p>';
}

function dex_add_widget() {
	wp_add_dashboard_widget( 'dex_lanterns', 'Lanterns', 'dex_dashboard_widget' );
}
add_action( 'wp_dashboard_setup', 'dex_add_widget' );
