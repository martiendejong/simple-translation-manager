<?php
/**
 * Plugin Name: Skeleton Plugin
 * Description: Invented plugin made only of the standard WordPress plugin skeleton plus one tiny function of its own. Used only by tests.
 * Version: 1.0.0
 * Author: Fifth Fixture Author
