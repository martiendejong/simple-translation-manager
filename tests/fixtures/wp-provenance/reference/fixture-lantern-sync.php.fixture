if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

define( 'FLS_VERSION', '1.0.0' );
define( 'FLS_PLUGIN_DIR', plugin_dir_path( __FILE__ ) );

require_once FLS_PLUGIN_DIR . 'includes/class-registry.php';
require_once FLS_PLUGIN_DIR . 'includes/class-sync.php';
require_once FLS_PLUGIN_DIR . 'includes/class-rest.php';

function fls_boot() {
	load_plugin_textdomain( 'fixture-lantern-sync', false, dirname( plugin_basename( __FILE__ ) ) . '/languages' );
	FLS_Rest::register();
}
add_action( 'plugins_loaded', 'fls_boot' );

register_activation_hook( __FILE__, array( 'FLS_Registry', 'install' ) );
